# Copy to .env and customize for local development. Never commit secrets.
# Without DATABASE_URL the backend uses a local SQLite file.
DATABASE_URL=sqlite:///./factory_monitor.db
# Optional Redis cache; unavailable Redis does not block persistence.
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
SIMULATOR_ENABLED=true
